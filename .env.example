# Pecan branch processor — deployment configuration.
#
# The installer (install.sh / mintctl) generates a real .env from this
# template; from a source checkout everything has a working default and no
# .env is needed. Compose reads this file automatically from the project
# directory.

# Image tag to run, e.g. v0.2.0. Immutable release tags are what installs
# pin; "latest" tracks the newest release, "edge" the newest main commit.
VERSION=latest

# Compose project name; also prefixes the named volumes. The installer sets
# it once so moving the install directory never orphans the volumes.
#COMPOSE_PROJECT_NAME=pecan

# Host port for the operator/teller web UI.
UI_PORT=9090

# Host interface for the UI port. The installer sets 127.0.0.1 in TLS mode so
# Caddy on :80/:443 is the only public surface (the direct port stays
# reachable over SSH for debugging); 0.0.0.0 in plain-HTTP mode.
BIND_ADDR=0.0.0.0

# Compose profiles select the stack shape: "tls" adds the bundled Caddy,
# "mint" adds the bundled cdk-mintd, "tls,mint" both. The installer sets this.
#COMPOSE_PROFILES=tls

# Console TLS. Set CONSOLE_DOMAIN (with profile "tls") to serve the console
# at https://$CONSOLE_DOMAIN via the bundled Caddy with automatic Let's
# Encrypt certificates. The name needs a DNS A/AAAA record pointing at this
# server, and ports 80+443 must be reachable.
#CONSOLE_DOMAIN=console.example.org

# First boot only (before users.json exists): seeds the "admin" account with
# this password instead of the demo admin/admin credentials. Minimum 8
# characters. Inert once the user store exists; kept here as a recovery path
# in case the printed password is lost before the operator changes it. The
# console forces a password change at the first sign-in with this password.
#INITIAL_ADMIN_PASSWORD=

# Optional ACME account email; mintctl re-applies it to the Caddyfile after
# updates.
#ACME_EMAIL=

# Payment gRPC published for your cdk-mintd. Loopback by default (mint on the
# same host); 0.0.0.0 exposes it to the network for a mint on another machine.
# Plaintext gRPC carries no authentication — firewall it to the mint's host,
# or enable TLS below.
#GRPC_BIND_ADDR=127.0.0.1
#GRPC_PORT=50051

# Optional mutual TLS for the payment gRPC endpoint: path INSIDE the
# container to a directory with server.pem, server.key, and ca.pem (client
# certificates are verified against ca.pem). Add a matching bind mount in a
# compose override, and set [grpc_processor].tls_dir on the mint side —
# the console's config snippet adjusts automatically.
#GRPC_TLS_DIR=/etc/processor-tls

# First boot only (before setup.json exists): pre-seeds the console's Mint-tab
# attachment so the install boots already connected. Written by the installer
# for bundled-mint installs and headless attach flags; inert once setup.json
# exists — later changes happen in the console.
#INITIAL_UNIT=
#INITIAL_MINT_URL=
#INITIAL_ADVERTISED_GRPC=

# Bundled mint (compose profile "mint") — all written by the installer.
# MINT_VERSION pins the official cashubtc/mintd image tag. It moves
# independently of VERSION: `mintctl update` never touches it; upgrade the
# mint deliberately with `mintctl update --mint-version <tag>`.
#MINT_VERSION=0.18.2

# Host port for the mint's wallet-facing HTTP API.
#MINT_PORT=3338

# Host interface for the mint port: 127.0.0.1 in TLS/behind-proxy modes (the
# proxy is the public surface), 0.0.0.0 in plain-HTTP mode.
#MINT_BIND_ADDR=127.0.0.1

# The mint's public hostname (TLS/behind-proxy modes). Also becomes a compose
# network alias on the caddy container so the processor's checks reach the
# mint's public URL without hairpin NAT.
#MINT_DOMAIN=mint.example.org
